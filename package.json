{
  "name": "handoff-css",
  "version": "0.9.0",
  "description": "Turn a Figma Design Handoff export into production-ready CSS custom properties, style classes, a Tailwind v4 @theme bridge and a reconciliation report.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "handoff-css": "bin/handoff-css.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./presets/jhd": "./presets/jhd.config.mjs",
    "./schema": "./schema/config.schema.json",
    "./schema/export": "./schema/design-system-handoff.schema.json",
    "./schema/export/v12plus": "./schema/design-system-handoff.v12plus.schema.json",
    "./schema/brief": "./schema/design-handoff.v10.schema.json",
    "./schema/brief/v11": "./schema/design-handoff.v11.schema.json",
    "./schema/brief/v12": "./schema/design-handoff.v12.schema.json",
    "./schema/brief/v13": "./schema/design-handoff.v13.schema.json"
  },
  "files": [
    "bin",
    "src",
    "scripts",
    "presets",
    "schema",
    "docs",
    "skills",
    "AGENTS.md",
    "README.md",
    "fixtures/jhd-v8b-2026-09-10/styles.css",
    "fixtures/jhd-v11-2026-09-12/styles.css",
    "fixtures/jhd-v13-2026-09-12/styles.css"
  ],
  "scripts": {
    "test": "node --test 'test/**/*.test.mjs'",
    "validate": "node bin/handoff-css.mjs validate",
    "skills": "node scripts/build-skill-adapters.mjs",
    "skills:check": "node scripts/build-skill-adapters.mjs --check"
  },
  "keywords": [
    "figma",
    "design-tokens",
    "css-custom-properties",
    "tailwindcss",
    "design-system"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
