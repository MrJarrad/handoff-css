{
  "name": "handoff-css",
  "version": "0.2.0",
  "description": "Turn a Figma Design Handoff export into production-ready CSS custom properties, a Tailwind v4 @theme bridge and a reconciliation report.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "handoff-css": "bin/handoff-css.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./presets/jhd": "./presets/jhd.config.mjs",
    "./schema": "./schema/config.schema.json"
  },
  "files": [
    "bin",
    "src",
    "presets",
    "schema",
    "docs",
    "skills",
    "README.md",
    "fixtures/jhd-v8b-2026-09-10/styles.css"
  ],
  "scripts": {
    "test": "node --test 'test/**/*.test.mjs'"
  },
  "keywords": [
    "figma",
    "design-tokens",
    "css-custom-properties",
    "tailwindcss",
    "design-system"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
