                "type": "string"
              },
              "scale": {
                "type": "number"
              }
            }
          }
        },
        "failed": {
          "type": "array"
        }
      }
    },
    "linkRun": {
      "$ref": "#/$defs/linkRun"
    },
    "specs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "markdown"
