{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://handoff-css/schema/ramp-proposal.v1.schema.json",
  "title": "Ramp proposal",
  "description": "A whole primitive colour ramp in the system's own steps and naming, and the step each named semantic colour would use in each mode. A patch: nothing is written into Figma.",
  "type": "object",
  "additionalProperties": false,
  "required": ["rampVersion", "source", "writes", "basis", "anchors", "merge", "ramps", "mapping", "questions", "open"],
  "$defs": {
    "hex": { "type": "string", "pattern": "^#[0-9a-f]{6}$" },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variable", "hex"],
      "properties": { "variable": { "type": "string" }, "hex": { "$ref": "#/$defs/hex" }, "ratio": { "type": "number" } }
    }
  },
  "properties": {
    "rampVersion": { "const": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentName", "contentHash"],
      "properties": { "documentName": { "type": ["string", "null"] }, "contentHash": { "type": ["string", "null"] } }
    },
    "writes": { "const": "nothing" },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ramps", "steps", "lightness", "reason"],
      "properties": {
        "kind": { "enum": ["fitted", "defaults"] },
        "ramps": { "type": "integer", "minimum": 0 },
        "steps": { "type": "array", "items": { "type": "number" } },
        "lightness": { "type": "object", "additionalProperties": false, "properties": { "min": { "type": "number" }, "max": { "type": "number" } } },
        "reason": { "type": "string" }
      }
    },
    "anchors": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object", "additionalProperties": false, "required": ["hex"], "properties": { "hex": { "type": "string" }, "step": { "type": "number" } } }
    },
    "merge": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["merge", "reasons"],
      "properties": { "merge": { "type": "boolean" }, "reasons": { "type": "array", "items": { "type": "object" } } }
    },
    "ramps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "nameSource", "collection", "parent", "placement", "audit", "variables"],
        "properties": {
          "name": { "type": "string" },
          "nameSource": { "enum": ["given", "generated"] },
          "collection": { "type": ["string", "null"] },
          "parent": { "type": "string" },
          "placement": { "type": "array", "items": { "type": "object" } },
          "audit": { "type": "object" },
          "variables": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "webName", "step", "hex"],
              "properties": {
                "name": { "type": "string" },
                "webName": { "type": ["string", "null"] },
                "step": { "type": "number" },
                "hex": { "$ref": "#/$defs/hex" },
                "anchor": { "const": true },
                "nudged": { "type": "object", "additionalProperties": false, "required": ["from"], "properties": { "from": { "$ref": "#/$defs/hex" } } }
              }
            }
          }
        }
      }
    },
    "mapping": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["semantic", "collection", "mode", "step", "hex", "use", "surfaces", "ratio", "pass", "reason"],
        "properties": {
          "semantic": { "type": "string" },
          "collection": { "type": "string" },
          "mode": { "type": "string" },
          "step": { "type": ["number", "null"] },
          "hex": { "type": ["string", "null"] },
          "use": { "enum": ["text", "large-text", "ui"] },
          "surfaces": { "type": "array", "items": { "$ref": "#/$defs/surface" } },
          "ratio": { "type": ["number", "null"] },
          "pass": { "type": "boolean" },
          "reason": { "type": "string" }
        }
      }
    },
    "questions": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": false, "required": ["id", "ask", "ramp"], "properties": { "id": { "const": "name" }, "ask": { "type": "string" }, "ramp": { "type": "string" } } }
    },
    "open": { "type": "integer", "minimum": 0 }
  }
}
