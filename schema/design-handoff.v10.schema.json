{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://handoff-css/schema/design-handoff.v10.schema.json",
  "title": "Design Handoff brief — JSON companion (schema design-handoff v10)",
  "description": "P17/0.4.1 — the Design Handoff plugin (export v14+) emits this JSON alongside the layer-brief markdown, carrying the same identity and node data structured. Validated SHAPE only: the top-level identity fields the markdown front matter must reconcile against, plus the node/index shapes a brief always carries. What a value MEANS is the plugin's business, not this schema's. `additionalProperties: false` throughout: this schema is versioned, so an unknown field is a finding — bump the schema rather than let it validate silently.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schemaVersion", "contract", "generatedAt", "exportVersion",
    "documentName", "pageName", "contentHash", "designSystemStateHash", "companion",
    "breakpoints", "selectedNodes"
  ],
  "$defs": {
    "layerNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "type", "depth", "visible"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "depth": { "type": "integer" },
        "visible": { "type": "boolean" },
        "link": { "type": "string" },
        "parentId": { "type": "string" },
        "absolute": { "type": "boolean" },
        "absoluteBounds": {
          "type": "object",
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "width": { "type": "number" },
            "height": { "type": "number" }
          }
        },
        "dimensions": {
          "type": "object",
          "properties": {
            "width": { "type": "number" },
            "height": { "type": "number" },
            "widthToken": { "type": ["string", "null"] },
            "heightToken": { "type": ["string", "null"] },
            "hSizing": { "type": "string" },
            "vSizing": { "type": "string" }
          }
        },
        "cornerRadius": {
          "type": "object",
          "properties": {
            "topLeft": { "type": "number" },
            "topRight": { "type": "number" },
            "bottomLeft": { "type": "number" },
            "bottomRight": { "type": "number" },
            "uniform": { "type": "boolean" },
            "tokens": { "type": "object" }
          }
        },
        "fills": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "color": { "type": "string" }
            }
          }
        },
        "strokes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "color": { "type": "string" },
              "weight": { "type": "number" },
              "align": { "type": "string" }
            }
          }
        },
        "semantic": { "type": "string" },
        "gridPlacement": {
          "type": "object",
          "properties": {
            "colStart": { "type": "number" },
            "colSpan": { "type": "number" },
            "colCount": { "type": "number" },
            "rowStart": { "type": "number" },
            "rowSpan": { "type": "number" }
          }
        },
        "layout": {
          "type": "object",
          "properties": {
            "mode": { "type": "string" },
            "gap": { "type": "object" },
            "padding": { "type": "object" }
          }
        },
        "component": {
          "type": "object",
          "properties": {
            "sourceId": { "type": "string" },
            "sourceName": { "type": "string" },
            "sourceLink": { "type": "string" },
            "setName": { "type": ["string", "null"] },
            "props": { "type": "object" }
          }
        },
        "modes": { "type": "object" },
        "clip": { "type": "boolean" },
        "interactive": {
          "type": "array",
          "items": { "type": "string" }
        },
        "aspectRatio": {
          "type": "object",
          "properties": {
            "label": { "type": "string" },
            "token": { "type": ["string", "null"] },
            "locked": { "type": "boolean" }
          }
        },
        "annotations": {
          "type": "array",
          "items": { "type": "string" }
        },
        "constraints": {
          "type": "object",
          "properties": {
            "horizontal": { "type": "string" },
            "vertical": { "type": "string" }
          }
        },
        "text": {
          "type": "object",
          "properties": {
            "characters": { "type": "string" },
            "verticalAlign": { "type": "string" },
            "textWrap": { "type": "string" }
          }
        },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/layerNode" }
        }
      }
    },
    "selectedNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" }
      }
    },
    "componentIndexEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "count"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "link": { "type": "string" },
        "count": { "type": "integer" },
        "perFrame": { "type": "object" }
      }
    },
    "variableTokenEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "count"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "aliasId": { "type": "string" },
        "count": { "type": "integer" }
      }
    },
    "prototypeFlowEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceName", "sourceId", "trigger", "action"],
      "properties": {
        "sourceName": { "type": "string" },
        "sourceId": { "type": "string" },
        "trigger": { "type": "string" },
        "action": { "type": "string" },
        "destination": { "type": "string" },
        "destinationId": { "type": "string" },
        "transition": { "type": "string" }
      }
    },
    "motionTransitionTokenEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "kind"],
      "properties": {
        "name": { "type": "string" },
        "value": { "type": "string" },
        "kind": { "type": "string" }
      }
    }
  },
  "properties": {
    "schema": { "const": "design-handoff" },
    "schemaVersion": { "const": 10 },
    "contract": { "type": "string" },
    "lane": { "type": "string" },
    "generatedAt": { "type": "string" },
    "exportVersion": { "type": "integer" },
    "documentName": { "type": "string" },
    "pageName": { "type": "string" },
    "contentHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "designSystemStateHash": { "type": "string" },
    "fingerprintPolicyVersion": { "type": ["string", "integer"] },
    "figma": { "type": "object" },
    "companion": {
      "type": "object",
      "required": ["schema", "schemaVersion", "contentHash", "designSystemStateHash"],
      "properties": {
        "schema": { "const": "design-system-handoff" },
        "schemaVersion": { "type": "integer" },
        "artifactFilename": { "type": "string" },
        "contentHash": { "type": "string" },
        "designSystemStateHash": { "type": "string" },
        "stale": { "type": "boolean" }
      }
    },
    "breakpoints": { "type": "object" },
    "selectedNodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/selectedNode" }
    },
    "options": { "type": "object" },
    "policies": { "type": "object" },
    "changes": { "type": "object" },
    "layerTree": {
      "type": "array",
      "items": { "$ref": "#/$defs/layerNode" }
    },
    "componentIndex": {
      "type": "array",
      "items": { "$ref": "#/$defs/componentIndexEntry" }
    },
    "variableTokens": {
      "type": "array",
      "items": { "$ref": "#/$defs/variableTokenEntry" }
    },
    "prototypeFlows": {
      "type": "array",
      "items": { "$ref": "#/$defs/prototypeFlowEntry" }
    },
    "motionEntries": { "type": "array" },
    "zIndexScale": { "type": "array" },
    "motionTransitionTokens": {
      "type": "array",
      "items": { "$ref": "#/$defs/motionTransitionTokenEntry" }
    }
  }
}
